    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.18",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-document-picker": "~58.0.4",
    "expo-font": "~58.0.10",
    "expo-image-picker": "~58.0.10",
    "expo-location": "~58.0.19",
    "expo-media-library": "~58.0.12",
    "expo-modules-core": "~58.0.26",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-maps": "1.29.11",
