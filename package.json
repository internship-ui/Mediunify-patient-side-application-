  "main": "index.js",
  "homepage": "https://internship-ui.github.io/Mediunify-patient-side-application-",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "predeploy": "npx expo export -p web && node scripts/patchGhPages.js && node -e \"require('fs').writeFileSync('dist/.nojekyll', '')\"",
    "deploy": "gh-pages -d dist -t",
    "postinstall": "node scripts/patchExpoAsset.js && node scripts/patchExpoFont.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.17",
