{
  "expo": {
    "name": "MediUnify",
    "slug": "mediunify",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/logo.png",
      "baseUrl": "/Mediunify-patient-side-application-"
    },
    "plugins": [
      "expo-font",
      "expo-asset"
    ]
  }
}
